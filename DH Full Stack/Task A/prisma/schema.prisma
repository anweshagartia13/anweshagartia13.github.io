generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum LeadStatus {
  NEW
  CONTACTED
  CLOSED
}

enum BudgetRange {
  UNDER_500
  BETWEEN_500_1000
  BETWEEN_1000_5000
  ABOVE_5000
}

model Lead {
  id        String      @id @default(cuid())
  name      String
  email     String
  budget    String
  message   String
  status    String      @default("NEW")
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([email])
  @@index([status])
  @@index([createdAt])
}
